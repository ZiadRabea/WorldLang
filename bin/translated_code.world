func باقي(رقم, قاعدة)
	# متغيرات and ثوابت
	var العتبة = 0.000001 
	var عدد_أقصي = 100
	var اقل_ = 0.0
	var أكبر_ = 1.0
	var وسط_ = (اقل_ + أكبر_)/2
	
	from ا = 0 to عدد_أقصي do
		var القيمة = قاعدة ^ وسط_

		if abs(القيمة) <= العتبة  do return وسط_
		
		if القيمة > رقم do 
			var أكبر_ = وسط_
		else 
			var اقل_ = وسط_
		end
		
		var وسط_ = (اقل_ + أكبر_)/2
	end
	return وسط_
end

func سجل(قاعدة, رقم)
#	
#	#تفادي حالات حدوث الخطأ
#	
	if قاعدة < 1 do print("قاعدة غير معرفة لللوغريتم")
	if رقم < 1 do print("رقم غير معرف لللوغريتم")
	var النتيجة = 0	
	# المنطق
	while رقم >= قاعدة do 
		var رقم = رقم/قاعدة
		var النتيجة = النتيجة + 1
	end
	if رقم != 1 do var النتيجة = النتيجة + باقي(رقم, قاعدة)
	return النتيجة
end

var نتيجة = سجل(2,11)
print(نتيجة)		